import os.path

# A face: its own package.json (UUID, name, resources), resources/,
# src/c/face_config.h and src/pkjs/. The watchface engine is shared by
# every face and lives in ../../shared/src/c; the phone-side code shared by
# faces is in ../../shared/src/pkjs.
SHARED_C = '../../shared/src/c'

top = '.'
out = 'build'

def options(ctx):
    ctx.load('pebble_sdk')

def configure(ctx):
    ctx.load('pebble_sdk')

def build(ctx):
    ctx.load('pebble_sdk')
    build_worker = os.path.exists('worker_src')
    binaries = []
    cached_env = ctx.env
    for platform in ctx.env.TARGET_PLATFORMS:
        ctx.env = ctx.all_envs[platform]
        ctx.set_group(ctx.env.PLATFORM_NAME)
        app_elf = '{}/pebble-app.elf'.format(ctx.env.BUILD_DIR)
        sources = (ctx.path.ant_glob('src/c/**/*.c') +
                   ctx.path.find_dir(SHARED_C).ant_glob('**/*.c'))
        ctx.pbl_build(source=sources, target=app_elf, bin_type='app',
                      includes=['src/c'])
        if build_worker:
            worker_elf = '{}/pebble-worker.elf'.format(ctx.env.BUILD_DIR)
            binaries.append({'platform': platform, 'app_elf': app_elf,
                             'worker_elf': worker_elf})
            ctx.pbl_build(source=ctx.path.ant_glob('worker_src/c/**/*.c'),
                          target=worker_elf, bin_type='worker')
        else:
            binaries.append({'platform': platform, 'app_elf': app_elf})
    ctx.env = cached_env
    ctx.set_group('bundle')
    ctx.pbl_bundle(binaries=binaries,
                   js=ctx.path.ant_glob(['src/pkjs/**/*.js',
                                         'src/pkjs/**/*.json']) +
                      ctx.path.find_dir('../../shared/src/pkjs').ant_glob('**/*.js'),
                   js_entry_file='src/pkjs/index.js')
